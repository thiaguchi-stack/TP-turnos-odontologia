# Base de datos (SQLite por defecto en desarrollo)
DATABASE_URL=sqlite:///./clinica.db

# Clave secreta para firmar tokens (valor FICTICIO de desarrollo, cambiar en prod)
SECRET_KEY=cambiame-por-un-valor-ficticio-de-desarrollo

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Vigencia del token de acceso en minutos
TOKEN_EXPIRE_MIN=60
